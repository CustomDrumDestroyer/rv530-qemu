+
+/*
+ * rv530 drag and drop (qemu/patches/0006, as 0003 does for GTK): with
+ * RV530_DND_SEND set to a command (rv530's scripts/dnd/dnd-send.py), files
+ * dropped on the window are handed to "CMD --at X,Y PATH..." with the drop
+ * point in guest pixels; a guest agent delivers them there.
+ */
+- (NSDragOperation) draggingEntered:(id<NSDraggingInfo>)sender
+{
+    NSDictionary *opts = @{ NSPasteboardURLReadingFileURLsOnlyKey: @YES };
+
+    return [[sender draggingPasteboard] canReadObjectForClasses:@[[NSURL class]]
+                                                        options:opts] ?
+           NSDragOperationCopy : NSDragOperationNone;
+}
+
+- (NSDragOperation) draggingUpdated:(id<NSDraggingInfo>)sender
+{
+    return [self draggingEntered:sender];
 }
 
+- (BOOL) performDragOperation:(id<NSDraggingInfo>)sender
+{
+    NSDictionary *opts = @{ NSPasteboardURLReadingFileURLsOnlyKey: @YES };
+    NSArray *urls = [[sender draggingPasteboard] readObjectsForClasses:@[[NSURL class]]
+                                                               options:opts];
+    /* the bounds are the guest surface, with the origin at the bottom left */
+    NSPoint p = [self convertPoint:[sender draggingLocation] fromView:nil];
+    int x = p.x, y = screen.height - p.y;
+    g_autoptr(GPtrArray) argv = g_ptr_array_new_with_free_func(g_free);
+    g_autoptr(GError) err = NULL;
+
+    if (![urls count] || x < 0 || y < 0 || x >= screen.width || y >= screen.height) {
+        return NO;
+    }
+    g_ptr_array_add(argv, g_strdup(dnd_cmd));
+    g_ptr_array_add(argv, g_strdup("--at"));
+    g_ptr_array_add(argv, g_strdup_printf("%d,%d", x, y));
+    for (NSURL *url in urls) {
+        g_ptr_array_add(argv, g_strdup([url fileSystemRepresentation]));
+    }
+    g_ptr_array_add(argv, NULL);
+    if (!g_spawn_async(NULL, (char **)argv->pdata, NULL, G_SPAWN_SEARCH_PATH,
+                       NULL, NULL, NULL, &err)) {
+        error_report("drag and drop: %s", err->message);
+        return NO;
+    }
+    return YES;
+}
+
+/*
+ * Dragging files out of the guest (rv530 issue #32): when the pointer
+ * leaves the view with the button held and "CMD --query" reports that the
+ * guest is dragging files (their names, one per line), start a host drag.
+ * Its file URLs come from "CMD --fetch" (host copies, one path per line)
+ * once a drop target asks for them.  When the host drag ends the guest's
+ * drag is cancelled with Escape before the button is released, so nothing
+ * is dropped inside the guest.
+ */
+- (void) dragOutOfGuest:(NSEvent *)event
+{
+    g_autofree char *names = NULL;
+    g_auto(GStrv) lines = NULL;
+    NSMutableArray *items = [NSMutableArray array];
+    NSMutableArray *pbitems = [NSMutableArray array];
+    NSPoint p = [self convertPoint:[event locationInWindow] fromView:nil];
+    CGFloat size = 32 * screen.height / [self frame].size.height;
+    NSDraggingSession *session;
+    int i;
+
+    if (!dnd_run("--query", &names)) {
+        return;
+    }
+    lines = g_strsplit(names, "\n", -1);
+    for (i = 0; lines[i]; i++) {
+        NSPasteboardItem *pbitem;
+        NSDraggingItem *item;
+        NSString *name;
+
+        if (!*lines[i]) {
+            continue;
+        }
+        name = [NSString stringWithUTF8String:lines[i]];
+        pbitem = [[[NSPasteboardItem alloc] init] autorelease];
+        [pbitem setDataProvider:self forTypes:@[NSPasteboardTypeFileURL]];
+        item = [[[NSDraggingItem alloc] initWithPasteboardWriter:pbitem] autorelease];
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+        [item setDraggingFrame:NSMakeRect(p.x - size / 2 + [items count] * size / 4,
+                                          p.y - size / 2 - [items count] * size / 4,
+                                          size, size)
+                      contents:[[NSWorkspace sharedWorkspace]
+                                   iconForFileType:[name pathExtension]]];
+#pragma clang diagnostic pop
+        [items addObject:item];
+        [pbitems addObject:pbitem];
+    }
+    if (![items count]) {
+        return;
+    }
+    dndItems = [pbitems retain];
+    [dndPaths release];
+    dndPaths = nil;
+    /* the host cursor shows the drag; it is hidden while the guest has it */
+    [self unhideCursor];
+    session = [self beginDraggingSessionWithItems:items event:event source:self];
+    [session setAnimatesToStartingPositionsOnCancelOrFail:NO];
+}
+
+- (void) pasteboard:(NSPasteboard *)pasteboard item:(NSPasteboardItem *)item
+         provideDataForType:(NSPasteboardType)type
+{
+    NSUInteger i = [dndItems indexOfObjectIdenticalTo:item];
+
+    if (!dndPaths) {
+        g_autofree char *out = NULL;
+        NSMutableArray *paths = [NSMutableArray array];
+
+        if (dnd_run("--fetch", &out) && out) {
+            for (NSString *line in [[NSString stringWithUTF8String:out]
+                                       componentsSeparatedByString:@"\n"]) {
+                if ([line length]) {
+                    [paths addObject:line];
+                }
+            }
+        }
+        dndPaths = [paths retain];
+    }
+    if (i < [dndPaths count]) {
+        [item setString:[[NSURL fileURLWithPath:dndPaths[i]] absoluteString]
+                forType:NSPasteboardTypeFileURL];
+    }
+}
+
+- (NSDragOperation) draggingSession:(NSDraggingSession *)session
+    sourceOperationMaskForDraggingContext:(NSDraggingContext)context
+{
+    return context == NSDraggingContextOutsideApplication ?
+           NSDragOperationCopy : NSDragOperationNone;
+}
+
+- (void) draggingSession:(NSDraggingSession *)session
+            endedAtPoint:(NSPoint)screenPoint
+               operation:(NSDragOperation)operation
+{
+    NSPoint p = [self convertPoint:[[self window] convertPointFromScreen:screenPoint]
+                          fromView:nil];
+
+    [dndItems release];
+    dndItems = nil;
+    [dndPaths release];
+    dndPaths = nil;
+    with_bql(^{
+        qkbd_state_key_event(kbd, KEY_ESC, true);
+        qkbd_state_key_event(kbd, KEY_ESC, false);
+    });
+    [self hideCursor];
+    dndOutside = !NSPointInRect(p, [self bounds]);
+    /*
+     * The keyboard and the tablet are separate USB devices: a button
+     * released at once can reach the guest before the Escape and drop the
+     * files where the drag left the window (seen under TCG).
+     */
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 300 * NSEC_PER_MSEC),
+                   dispatch_get_main_queue(), ^{
+        if (dndOutside) {
+            [self ungrabMouse];         /* releases the buttons */
+        } else {
+            with_bql(^{
+                qemu_input_queue_btn(dcl.con, INPUT_BUTTON_LEFT, false);
+                qemu_input_event_sync();
+            });
+        }
+    });
+}
