+
+/* rv530: run "RV530_DND_SEND OPT", its standard output in *out */
+static bool dnd_run(const char *opt, char **out)
+{
+    char *argv[] = { (char *)dnd_cmd, (char *)opt, NULL };
+    gint status = -1;
+
+    if (!dnd_cmd || !g_spawn_sync(NULL, argv, NULL, G_SPAWN_SEARCH_PATH |
+                                  G_SPAWN_STDERR_TO_DEV_NULL, NULL, NULL, out,
+                                  NULL, &status, NULL)) {
+        return false;
+    }
+    return status == 0;
+}
