+/*
+ * rv530 "Resize Guest with Window" (#46): for a display device with a
+ * run-time "auto-resize" property, switch whether the guest resolution
+ * follows the window.  Off, the window scales the guest image instead.
+ */
+- (void)resizeGuestWithWindow:(id)sender
+{
+    bool on = [sender state] != NSControlStateValueOn;
+    NSWindow *window = [cocoaView window];
+    bool resizable = [window styleMask] & NSWindowStyleMaskResizable;
+
+    [sender setState:on ? NSControlStateValueOn : NSControlStateValueOff];
+    with_bql(^{
+        object_property_set_bool(resize_dev, "auto-resize", on, NULL);
+    });
+    if (on && resizable) {
+        /* the guest takes the window's size as it is: just drop the aspect lock */
+        [window setContentResizeIncrements:NSMakeSize(1, 1)];
+    } else {
+        if (on) {
+            /* the window must be free to take any size */
+            [window setStyleMask:[window styleMask] | NSWindowStyleMaskResizable];
+            [zoom_item setState:NSControlStateValueOn];
+            /* the window takes the guest's size, in points */
+            [cocoaView followGuestSize];
+        } else {
+            /* the aspect lock is back */
+            [cocoaView resizeWindow];
+        }
+    }
+    if (on) {
+        /* the device applies the last size it was told: make it current */
+        with_bql(^{
+            [cocoaView updateUIInfoLockedDelay:false];
+        });
+    }
+}
+
