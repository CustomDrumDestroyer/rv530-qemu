From: CustomDrumDestroyer <350583592+CustomDrumDestroyer@users.noreply.github.com>
Subject: [PATCH] hw/display: build the rv530 device

Adds hw/display/rv530 to the build, a CONFIG_RV530 Kconfig symbol and
the optional Vulkan backend (needs the vulkan and shaderc pkg-config
packages; without them the device builds with the CPU renderer only).
---
--- a/meson.build
+++ b/meson.build
@@ -3615,6 +3615,7 @@
     'hw/block',
     'hw/char',
     'hw/display',
+    'hw/display/rv530',
     'hw/dma',
     'hw/fsi',
     'hw/hexagon',
--- a/hw/display/Kconfig
+++ b/hw/display/Kconfig
@@ -153,3 +153,10 @@
     bool
     depends on MAC_PVG && PCI
     default y if PCI_DEVICES
+
+config RV530
+    bool
+    default y
+    depends on PCI
+    select DDC
+    select BITBANG_I2C
--- a/hw/display/meson.build
+++ b/hw/display/meson.build
@@ -143,3 +143,17 @@
 system_ss.add(when: 'CONFIG_OMAP', if_true: files('omap_lcdc.c'))
 
 modules += { 'hw-display': hw_display_modules }
+
+system_ss.add(when: 'CONFIG_RV530', if_true: files(
+  'rv530/rv530.c', 'rv530/r5xx_mc.c', 'rv530/r5xx_cp.c', 'rv530/r5xx_avivo.c',
+  'rv530/r5xx_2d.c', 'rv530/r5xx_3d.c', 'rv530/r5xx_core.c',
+  'rv530/r5xx_regnames.c', 'rv530/r5xx_tex.c', 'rv530/r5xx_pvs.c',
+  'rv530/r500_us.c', 'rv530/r5xx_raster.c', 'rv530/r5xx_vk_state.c',
+  'rv530/r5xx_edid.c', 'rv530/r5xx_atom.c', 'rv530/r5xx_clip.c'))
+rv530_vulkan = dependency('vulkan', required: false)
+rv530_shaderc = dependency('shaderc', required: false)
+if rv530_vulkan.found() and rv530_shaderc.found()
+  system_ss.add(when: 'CONFIG_RV530', if_true: [files('rv530/r5xx_vk.c'), rv530_vulkan, rv530_shaderc])
+else
+  system_ss.add(when: 'CONFIG_RV530', if_true: files('rv530/r5xx_vk_stub.c'))
+endif
