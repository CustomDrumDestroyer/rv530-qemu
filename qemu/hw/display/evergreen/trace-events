# See docs/devel/tracing.rst for syntax documentation.

# evergreen.c
eg_mmio_read(uint64_t addr, uint32_t val) "0x%05" PRIx64 " -> 0x%08x"
eg_mmio_write(uint64_t addr, uint32_t val) "0x%05" PRIx64 " <- 0x%08x"
eg_ih_push(uint32_t src, uint32_t data, uint32_t wptr) "src %u data 0x%x wptr 0x%x"

# eg_cp.c
eg_cp_kick(uint32_t rptr, uint32_t wptr) "rptr %u wptr %u"
eg_cp_pkt3(uint32_t op, uint32_t n) "opcode 0x%02x, %u dwords"
eg_dma_packet(uint32_t cmd, uint32_t sub, uint32_t count) "cmd 0x%x sub 0x%x count %u"

# eg_dce.c
eg_scanout(int crtc, uint32_t w, uint32_t h, uint32_t bpp, uint64_t addr) "CRTC%d %ux%u %u bytes/pixel at 0x%" PRIx64
eg_draw(uint32_t prim, uint32_t n, uint64_t vs, uint64_t ps, uint32_t cb0, uint32_t info) "prim 0x%x n %u vs 0x%" PRIx64 " ps 0x%" PRIx64 " cb0 0x%x info 0x%x"
eg_vk_fallback(const char *why) "%s"
