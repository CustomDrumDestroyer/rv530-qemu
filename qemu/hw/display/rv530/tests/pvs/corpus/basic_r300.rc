# target: vs-r300
# Same program as basic_r500.rc compiled for the R3xx vertex engine
# (no native ABS, SEQ/SNE or saturate; R300 flow control register layout).
# Execution check: ref_basic.
DP4 output[0].x, input[0], const[0];
DP4 output[0].y, input[0], const[1];
DP4 output[0].z, input[0], const[2];
DP4 output[0].w, input[0], const[3];
MUL temp[0], input[1], const[4];
ADD temp[1], temp[0], -input[2].wzyx;
MAD output[1], temp[1], const[5].xxxx, input[3];
MIN output[2].xy, temp[0], input[1];
MAX output[2].zw, temp[0], input[1];
SLT output[3].xy, input[1], const[4];
SGE output[3].zw, input[1], const[4];
FRC output[4], |input[2]|;
DST output[5], input[1], input[2];
DP3 output[6].x, input[1], input[2];
SUB output[6].yzw, input[1], input[2];
MOV output[7], input[3].yxwz;
