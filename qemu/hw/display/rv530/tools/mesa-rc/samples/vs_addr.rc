# target: vs-r300
# flags: --uniforms
# Vertex program with the address register: ARL + relative constant fetch.
const[0] {0.0, 0.0, 0.0, 1.0}
const[1] {1.0, 0.0, 0.0, 0.0}
const[2] {0.0, 1.0, 0.0, 0.0}
const[3] {0.0, 0.0, 1.0, 0.0}
const[4] {0.0, 0.0, 0.0, 1.0}
ARL addr[0].x, input[1].x;
DP4 output[0].x, input[0], const[1 + addr[0]];
DP4 output[0].y, input[0], const[2 + addr[0]];
DP4 output[0].z, input[0], const[3 + addr[0]];
DP4 output[0].w, input[0], const[4 + addr[0]];
MUL output[1], input[2], const[0].wwww;
