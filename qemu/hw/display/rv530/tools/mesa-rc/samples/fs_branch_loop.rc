# target: fs-r500
# R500 flow control: IF/ELSE/ENDIF and a loop with a counter and BRK.
const[0] {0.0, 1.0, 4.0, 0.25}
MOV temp[0], input[0];
MOV temp[2].x, const[0].x;
BGNLOOP;
  SGE temp[3].x, temp[2].x, const[0].z;
  IF temp[3].x;
    BRK;
  ENDIF;
  MUL temp[0], temp[0], const[0].wwww;
  ADD temp[2].x, temp[2].x, const[0].y;
ENDLOOP;
SGT temp[1].x, temp[0].x, const[0].w;
IF temp[1].x;
  ADD temp[0], temp[0], const[0].yyyy;
ELSE;
  MUL temp[0], temp[0], const[0].zzzz;
ENDIF;
MOV output[0], temp[0];
